# Supabase backend configuration.
# Copy to .env for local dev. For Vercel, set these in the project dashboard
# (Settings → Environment Variables) — never commit real keys.
#
# Find these in your Supabase project: Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# ---------------------------------------------------------------------------
# SECURITY NOTES
# ---------------------------------------------------------------------------
# - The anon/publishable key is safe to ship in the frontend; row-level
#   security (RLS) in Postgres is the real access boundary.
# - NEVER put the service_role key, the Postgres connection string, or the
#   database password in the frontend, in .env, or in git. Those are only
#   for running migrations (supabase/migrations/*.sql) from a trusted machine.
# - .env* is gitignored (only .env.example is committed).
